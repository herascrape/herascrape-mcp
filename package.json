{
  "name": "herascrape-mcp",
  "version": "0.1.0",
  "description": "MCP server for the herascrape Instagram API — connect Claude, Cursor, and other agents to herascrape.",
  "license": "MIT",
  "author": "herascrape",
  "homepage": "https://herascrape.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herascrape/herascrape-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/herascrape/herascrape-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "instagram api",
    "instagram scraper",
    "herascrape",
    "claude",
    "cursor"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "herascrape-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"**/*.ts\"",
    "format": "prettier --write \"**/*.ts\"",
    "test": "vitest run --minWorkers=1 --maxWorkers=2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "20.17.6",
    "eslint": "9.15.0",
    "prettier": "3.4.2",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.8"
  }
}
